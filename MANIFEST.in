include scripts/release/build_distribution.py
prune .git
prune .codex
prune .learnings
prune build
prune dist
prune moirekp.egg-info
prune devtools
prune dev_archive
prune review_bundles
prune review_outputs
prune review_packages
prune results
prune validation_runs
prune runs
prune output
prune tmp
prune paper
prune manuscript
prune cpc_submission
global-exclude __pycache__/*
global-exclude *.py[cod]
global-exclude *.so
global-exclude .DS_Store
global-exclude *.log
global-exclude *.err
global-exclude *.npy
global-exclude *.npz
global-exclude openmx.out
prune docs
prune tests
prune kp/kp/experimental
prune scripts/benchmarks
exclude RELEASE_BLOCKERS.md
exclude RELEASE_VALIDATION.md
exclude pytest.ini
exclude scripts/release_gate.sh
exclude scripts/release/release_gate.sh
exclude scripts/benchmark_physical_export.py
exclude scripts/benchmark_physical_export_suite.py
exclude tapw/environment.yml

