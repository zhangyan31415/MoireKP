#
# SCF or Electronic System
#

scf.XcType                 GGA-PBE     # LDA|LSDA-CA|LSDA-PW|GGA-PBE
scf.SpinPolarization         Off       # On|Off|NC
scf.SpinOrbit.Coupling       off       # On|Off, default=off
scf.ElectronicTemperature  300.0       # default=300 (K)
scf.energycutoff           120       # default=150 (Ry)
scf.maxIter                100        # default=40
scf.EigenvalueSolver        Band    # DC|GDC|Cluster|Band|Krylov
scf.Kgrid                   1 1 1      # means n1 x n2 x n3
scf.Mixing.Type            Rmm-diisk     # Simple|Rmm-Diis|Gr-Pulay|Kerker|Rmm-Diisk
scf.Init.Mixing.Weight     0.01        # default=0.30
scf.Min.Mixing.Weight      0.001       # default=0.001
scf.Max.Mixing.Weight      0.050       # default=0.40
scf.Mixing.History         35          # default=5
scf.Mixing.StartPulay      30          # default=6
scf.criterion             1.0e-7       # default=1.0e-6 (Hartree)
scf.lapack.dste            dstevx      # dstevx|dstedc|dstegr,default=dstevx
scf.eigen.lib      elpa2    # elpa1|elpa2, default=elpa1
#scf.restart.filename               mote2
#scf.restart                        c2n

