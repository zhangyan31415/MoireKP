# Fixed-geometry SCF on the relaxed structure used for the paper.
# DFT_DATA19 is a local symlink to the OpenMX PAO/VPS database.
System.CurrentDirectory ./
System.Name openmx
DATA.PATH ./DFT_DATA19
level.of.stdout                   1    # default=1 (1-3)
level.of.fileout                  0    # default=1 (0-2)
HS.fileout on

#
# SCF or Electronic System
#

scf.XcType                  GGA-PBE    # LDA|LSDA-CA|LSDA-PW|GGA-PBE
scf.SpinPolarization         NC          # On|Off|NC
scf.SpinOrbit.Coupling       on         # On|Off, default=off
scf.ElectronicTemperature  300.0       # default=300 (K)
scf.energycutoff           300.0       # default=150 (Ry)
scf.maxIter 200
scf.EigenvalueSolver        Band      # DC|GDC|Cluster|Band
scf.Kgrid                  1 1 1       # means 4x4x4
scf.Mixing.Type           rmm-diis     # Simple|Rmm-Diis|Gr-Pulay|Kerker|Rmm-Diisk
scf.Init.Mixing.Weight     0.10        # default=0.30
scf.Min.Mixing.Weight      0.001       # default=0.001
scf.Max.Mixing.Weight      0.050       # default=0.40
scf.Mixing.History          35          # default=5
scf.Mixing.StartPulay       50          # default=6
scf.criterion             1.0e-7      # default=1.0e-6 (Hartree)
scf.lapack.dste            dstevx      # dstevx|dstedc|dstegr,default=dstevx
scf.eigen.lib      elpa2    # elpa1|elpa2, default=elpa1
scf.restart off

#
# MD or Geometry Optimization
#

MD.Type Nomd
MD.maxIter                    1        # default=1
MD.TimeStep                   1        # default=0.5 (fs)
MD.Opt.criterion         1.0e-5        # default=1.0e-4 (Hartree/bohr)

#
# MO output
#

MO.fileout                  off        # on|off, default=off
num.HOMOs                    2         # default=1
num.LUMOs                    2         # default=1

#
# DOS and PDOS
#

Dos.fileout                  off       # on|off, default=off
Dos.Erange              -10.0  10.0    # default = -20 20
Dos.Kgrid                 1  1  1      # default = Kgrid1 Kgrid2 Kgrid3
#
# Definition of Atomic Species
#
Species.Number       2
<Definition.of.Atomic.Species
Te   Te7.0-s3p2d2f1       Te_PBE19
Mo   Mo7.0-s3p2d2       Mo_PBE19
Definition.of.Atomic.Species>

